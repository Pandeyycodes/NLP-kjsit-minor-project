# Where the frontend sends API requests (no trailing slash).
#
# Usually you do NOT need to set this:
#   - `npm run dev` uses http://127.0.0.1:8000 (the local uvicorn server).
#   - A production build (e.g. on Vercel) uses the same domain as the website.
#
# Set it only if the backend runs on a different domain, e.g. by copying this
# file to .env.local and uncommenting:
# VITE_API_BASE_URL=https://your-backend.example.com
